# Store Messages pl_PL translation (customer-facing email texts).
msgid ""
msgstr ""
"Project-Id-Version: Store Messages 1.2.2\n"
"Language: pl_PL\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n == 1 ? 0 : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 1 : 2);\n"
"X-Domain: store-messages\n"

msgid "Hi {first_name},"
msgstr "Cześć {first_name},"

msgid "Thank you for shopping with us,"
msgstr "Dziękujemy za zakupy w naszym sklepie,"

msgid "Tracking"
msgstr "Śledzenie przesyłki"

msgid "Track your package"
msgstr "Śledź przesyłkę"

msgid "Your order"
msgstr "Twoje zamówienie"

msgid "Your order #{order_number} is on its way"
msgstr "Twoje zamówienie #{order_number} jest w drodze"

msgid "Your order is on its way"
msgstr "Twoje zamówienie jest w drodze"

msgid "Track your package: {carrier} {tracking_number}"
msgstr "Śledź przesyłkę: {carrier} {tracking_number}"

msgid "Good news: your order <strong>#{order_number}</strong> has been shipped and is on its way to you."
msgstr "Dobra wiadomość: Twoje zamówienie <strong>#{order_number}</strong> zostało wysłane i jest już w drodze do Ciebie."

msgid "Tracking can take up to 24 hours to show the first update."
msgstr "Pierwsza informacja o statusie przesyłki może pojawić się w ciągu 24 godzin."

msgid "In this parcel"
msgstr "W tej paczce"

msgid "Shipping to"
msgstr "Adres dostawy"

msgid "Your order #{order_number} is ready for pickup"
msgstr "Twoje zamówienie #{order_number} jest gotowe do odbioru"

msgid "Ready for pickup"
msgstr "Gotowe do odbioru"

msgid "Your order is waiting for you at {site_name}."
msgstr "Twoje zamówienie czeka na Ciebie w sklepie {site_name}."

msgid "Your order <strong>#{order_number}</strong> is packed and ready for you to collect."
msgstr "Twoje zamówienie <strong>#{order_number}</strong> jest spakowane i czeka na odbiór."

msgid "Pickup address"
msgstr "Adres odbioru"

msgid "Please bring your order number with you."
msgstr "Prosimy o zabranie ze sobą numeru zamówienia."

msgid "An update about your order #{order_number}"
msgstr "Informacja o Twoim zamówieniu #{order_number}"

msgid "An update about your order"
msgstr "Informacja o Twoim zamówieniu"

msgid "One item in your order is unavailable."
msgstr "Jeden produkt z Twojego zamówienia jest niedostępny."

msgid "Thank you for your order <strong>#{order_number}</strong>. Unfortunately, one of the items you ordered is currently out of stock and we are unable to send it."
msgstr "Dziękujemy za zamówienie <strong>#{order_number}</strong>. Niestety jeden z zamówionych produktów jest obecnie niedostępny i nie możemy go wysłać."

msgid "We have refunded that item to your original payment method. The rest of your order is being prepared as usual."
msgstr "Zwróciliśmy należność za ten produkt na pierwotną metodę płatności. Pozostała część zamówienia jest przygotowywana jak zwykle."

msgid "Refunded: <strong>{refund_amount}</strong>. It can take a few business days to appear on your statement."
msgstr "Zwrócono: <strong>{refund_amount}</strong>. Może minąć kilka dni roboczych, zanim kwota pojawi się na Twoim wyciągu."

msgid "We are very sorry for the inconvenience. Simply reply to this email if you have any questions."
msgstr "Bardzo przepraszamy za niedogodności. W razie pytań po prostu odpowiedz na tę wiadomość."

msgid "Your refund for order #{order_number}"
msgstr "Zwrot środków za zamówienie #{order_number}"

msgid "Your refund is on its way"
msgstr "Zwrot środków jest w drodze"

msgid "Refund of {refund_amount} for order #{order_number}."
msgstr "Zwrot {refund_amount} za zamówienie #{order_number}."

msgid "We have processed a refund of <strong>{refund_amount}</strong> for your order <strong>#{order_number}</strong>."
msgstr "Zrealizowaliśmy zwrot w wysokości <strong>{refund_amount}</strong> za Twoje zamówienie <strong>#{order_number}</strong>."

msgid "Reason: {refund_reason}"
msgstr "Powód: {refund_reason}"

msgid "Depending on your bank, it can take a few business days for the money to reach your account."
msgstr "W zależności od banku środki mogą pojawić się na Twoim koncie dopiero po kilku dniach roboczych."

msgid "Your order #{order_number} needs a little more time"
msgstr "Twoje zamówienie #{order_number} potrzebuje nieco więcej czasu"

msgid "A short delay"
msgstr "Krótkie opóźnienie"

msgid "An update on when your order will ship."
msgstr "Informacja o terminie wysyłki Twojego zamówienia."

msgid "We wanted to let you know that your order <strong>#{order_number}</strong> is taking a little longer than usual to prepare."
msgstr "Chcemy poinformować, że przygotowanie Twojego zamówienia <strong>#{order_number}</strong> potrwa nieco dłużej niż zwykle."

msgid "We will send you the tracking link as soon as it ships. Thank you for your patience!"
msgstr "Link do śledzenia przesyłki wyślemy, gdy tylko zamówienie zostanie nadane. Dziękujemy za cierpliwość!"

msgid "Complete your order #{order_number}"
msgstr "Dokończ zamówienie #{order_number}"

msgid "Your order is waiting"
msgstr "Twoje zamówienie czeka"

msgid "Finish your payment to confirm order #{order_number}."
msgstr "Dokończ płatność, aby potwierdzić zamówienie #{order_number}."

msgid "Your order <strong>#{order_number}</strong> ({order_total}) is not paid yet. You can complete the payment securely with the button below."
msgstr "Twoje zamówienie <strong>#{order_number}</strong> ({order_total}) nie zostało jeszcze opłacone. Możesz bezpiecznie dokończyć płatność, klikając przycisk poniżej."

msgid "Complete payment"
msgstr "Dokończ płatność"

msgid "How are you enjoying your order, {first_name}?"
msgstr "Jak podoba Ci się zamówienie, {first_name}?"

msgid "How did we do?"
msgstr "Jak nam poszło?"

msgid "Your feedback helps other customers."
msgstr "Twoja opinia pomaga innym klientom."

msgid "We hope you are enjoying your order. Would you take a minute to tell other customers what you think? It means a lot to a small business like ours."
msgstr "Mamy nadzieję, że zamówienie spełnia Twoje oczekiwania. Czy znajdziesz chwilę, by podzielić się opinią z innymi klientami? Dla małej firmy takiej jak nasza to naprawdę wiele znaczy."

msgid "Leave a review"
msgstr "Dodaj opinię"

msgid "A message about your order #{order_number}"
msgstr "Wiadomość dotycząca Twojego zamówienia #{order_number}"

msgid "A message from {site_name}"
msgstr "Wiadomość od sklepu {site_name}"

msgid "A note about your order #{order_number}"
msgstr "Notatka do Twojego zamówienia #{order_number}"

msgid "A note about your order"
msgstr "Notatka do Twojego zamówienia"

msgid "Order #{order_number} · placed {order_date}"
msgstr "Zamówienie #{order_number} · złożone {order_date}"

msgid "Welcome to {site_name}{if coupon_code}: your {coupon_amount} code{/if}"
msgstr "Witamy w sklepie {site_name}{if coupon_code}: Twój kod na {coupon_amount} rabatu{/if}"

msgid "Thanks for signing up!"
msgstr "Dziękujemy za zapisanie się!"

msgid "Your personal code for {coupon_amount} off your first order is inside."
msgstr "W tej wiadomości znajdziesz osobisty kod na {coupon_amount} rabatu na pierwsze zamówienie."

msgid "Good to have you with us."
msgstr "Cieszymy się, że jesteś z nami."

msgid "Hello,"
msgstr "Witaj,"

msgid "Welcome to {site_name}! From now on you are the first to hear about new products and offers."
msgstr "Witamy w sklepie {site_name}! Od teraz będziesz dowiadywać się o nowościach i ofertach przed innymi."

msgid "Your personal code"
msgstr "Twój osobisty kod"

msgid "{coupon_amount} off your first order{if coupon_expires}, valid until {coupon_expires}{/if}. Enter it at checkout."
msgstr "Rabat {coupon_amount} na pierwsze zamówienie{if coupon_expires}, ważny do {coupon_expires}{/if}. Wpisz kod przy składaniu zamówienia."

msgid "Start shopping"
msgstr "Zacznij zakupy"

msgid "Our bestsellers"
msgstr "Nasze bestsellery"

msgid "Please confirm your subscription to {site_name}"
msgstr "Potwierdź zapis do newslettera sklepu {site_name}"

msgid "One more step"
msgstr "Jeszcze jeden krok"

msgid "Confirm your email address to start receiving our news."
msgstr "Potwierdź swój adres e-mail, aby otrzymywać nasze nowości."

msgid "Please confirm that you want to receive emails from {site_name}."
msgstr "Potwierdź, że chcesz otrzymywać wiadomości e-mail od sklepu {site_name}."

msgid "Yes, subscribe me"
msgstr "Tak, zapisz mnie"

msgid "If you did not sign up, simply ignore this email: you will not hear from us."
msgstr "Jeśli to nie było Twoje zgłoszenie, po prostu zignoruj tę wiadomość: nie będziemy się więcej z Tobą kontaktować."

msgid "Questions? Just reply to this email."
msgstr "Masz pytania? Po prostu odpowiedz na tę wiadomość."

msgid "Unsubscribe"
msgstr "Wypisz się"

msgid "Your {site_name} order #{order_number} has been received"
msgstr "Twoje zamówienie #{order_number} w {site_name} zostało przyjęte"

msgid "Thank you for your order"
msgstr "Dziękujemy za zamówienie"

msgid "We have received your order and are getting it ready."
msgstr "Otrzymaliśmy Twoje zamówienie i już je przygotowujemy."

msgid "We have received your order <strong>#{order_number}</strong> and are now getting it ready. We will let you know as soon as it is on its way."
msgstr "Otrzymaliśmy Twoje zamówienie <strong>#{order_number}</strong> i już je przygotowujemy. Damy Ci znać, gdy tylko zostanie wysłane."

msgid "Your order is on hold until we receive your payment."
msgstr "Twoje zamówienie czeka na płatność."

msgid "Thank you for your order <strong>#{order_number}</strong>. It is on hold until we confirm that your payment has been received."
msgstr "Dziękujemy za zamówienie <strong>#{order_number}</strong>. Czeka ono do momentu, gdy potwierdzimy otrzymanie Twojej płatności."

msgid "Your {site_name} order #{order_number} is complete"
msgstr "Twoje zamówienie #{order_number} w {site_name} zostało zrealizowane"

msgid "Your order is complete"
msgstr "Twoje zamówienie zostało zrealizowane"

msgid "We have finished processing your order."
msgstr "Zakończyliśmy realizację Twojego zamówienia."

msgid "We have finished processing your order <strong>#{order_number}</strong>."
msgstr "Zakończyliśmy realizację Twojego zamówienia <strong>#{order_number}</strong>."

msgid "Your {site_name} order #{order_number} has been partially refunded"
msgstr "Twoje zamówienie #{order_number} w {site_name} zostało częściowo zwrócone"

msgid "Your {site_name} order #{order_number} has been refunded"
msgstr "Twoje zamówienie #{order_number} w {site_name} zostało zwrócone"

msgid "Partial refund issued"
msgstr "Dokonano częściowego zwrotu"

msgid "Your order has been refunded"
msgstr "Zwróciliśmy pieniądze za Twoje zamówienie"

msgid "We have refunded <strong>{refund_amount}</strong> of your order <strong>#{order_number}</strong>."
msgstr "Zwróciliśmy <strong>{refund_amount}</strong> za Twoje zamówienie <strong>#{order_number}</strong>."

msgid "Your order <strong>#{order_number}</strong> has been refunded in full: <strong>{refund_amount}</strong>."
msgstr "Twoje zamówienie <strong>#{order_number}</strong> zostało w całości zwrócone: <strong>{refund_amount}</strong>."

msgid "The money goes back to your original payment method. It can take a few business days to appear on your statement."
msgstr "Pieniądze wracają na pierwotną metodę płatności. Może minąć kilka dni roboczych, zanim kwota pojawi się na Twoim wyciągu."

msgid "Your {site_name} order #{order_number} was unsuccessful"
msgstr "Twoje zamówienie #{order_number} w {site_name} nie powiodło się"

msgid "Your payment did not go through"
msgstr "Twoja płatność nie przeszła"

msgid "You can try again with another payment method."
msgstr "Możesz spróbować ponownie, wybierając inną metodę płatności."

msgid "Unfortunately, we could not complete your order <strong>#{order_number}</strong> because of a problem with the payment."
msgstr "Niestety nie mogliśmy sfinalizować Twojego zamówienia <strong>#{order_number}</strong> z powodu problemu z płatnością."

msgid "If you would still like to place it, you can pay again, with another payment method if you like."
msgstr "Jeśli nadal chcesz je złożyć, możesz zapłacić ponownie, w razie potrzeby inną metodą płatności."

msgid "Pay for this order"
msgstr "Zapłać za to zamówienie"

msgid "Your {site_name} order #{order_number} has been cancelled"
msgstr "Twoje zamówienie #{order_number} w {site_name} zostało anulowane"

msgid "Your order has been cancelled"
msgstr "Twoje zamówienie zostało anulowane"

msgid "Order #{order_number} has been cancelled."
msgstr "Zamówienie #{order_number} zostało anulowane."

msgid "We are writing to let you know that your order <strong>#{order_number}</strong> has been cancelled."
msgstr "Informujemy, że Twoje zamówienie <strong>#{order_number}</strong> zostało anulowane."

msgid "Invoice for order #{order_number} at {site_name}"
msgstr "Faktura do zamówienia #{order_number} w {site_name}"

msgid "Details of your order #{order_number}"
msgstr "Szczegóły Twojego zamówienia #{order_number}"

msgid "Your invoice"
msgstr "Twoja faktura"

msgid "Your order details"
msgstr "Szczegóły zamówienia"

msgid "Order #{order_number} · {order_total}"
msgstr "Zamówienie #{order_number} · {order_total}"

msgid "An order has been created for you at {site_name}. You can pay for it with the button below."
msgstr "W {site_name} utworzono dla Ciebie zamówienie. Możesz za nie zapłacić przyciskiem poniżej."

msgid "Here are the details of your order <strong>#{order_number}</strong>, placed on {order_date}."
msgstr "Oto szczegóły Twojego zamówienia <strong>#{order_number}</strong>, złożonego {order_date}."

msgid "Reset your {site_name} password"
msgstr "Zresetuj hasło do {site_name}"

msgid "Reset your password"
msgstr "Zresetuj hasło"

msgid "Someone asked for a new password for your account."
msgstr "Ktoś poprosił o nowe hasło do Twojego konta."

msgid "Someone asked for a new password for the account <strong>{user_login}</strong> at {site_name}."
msgstr "Ktoś poprosił o nowe hasło do konta <strong>{user_login}</strong> w {site_name}."

msgid "Choose a new password"
msgstr "Wybierz nowe hasło"

msgid "If you did not ask for this, simply ignore this email: your password stays the same."
msgstr "Jeśli to nie Ty, po prostu zignoruj tę wiadomość: Twoje hasło pozostanie bez zmian."

msgid "Your account at {site_name} has been created"
msgstr "Twoje konto w {site_name} zostało utworzone"

msgid "Welcome to {site_name}"
msgstr "Witamy w {site_name}"

msgid "Your account is ready."
msgstr "Twoje konto jest gotowe."

msgid "Thank you for creating an account at {site_name}. Your username is <strong>{user_login}</strong>."
msgstr "Dziękujemy za założenie konta w {site_name}. Twoja nazwa użytkownika to <strong>{user_login}</strong>."

msgid "Choose your password with the button below to start using your account."
msgstr "Wybierz hasło przyciskiem poniżej, aby zacząć korzystać z konta."

msgid "Choose your password"
msgstr "Wybierz hasło"

msgid "In your account you can see your orders, change your addresses and your password."
msgstr "W swoim koncie zobaczysz zamówienia oraz zmienisz adresy i hasło."

msgid "Go to my account"
msgstr "Przejdź do mojego konta"

msgid "Confirm your email address for {site_name}"
msgstr "Potwierdź adres e-mail dla {site_name}"

msgid "Confirm your email address"
msgstr "Potwierdź adres e-mail"

msgid "One click to link your past orders to your account."
msgstr "Jedno kliknięcie, aby połączyć wcześniejsze zamówienia z kontem."

msgid "Please confirm that <strong>{customer_email}</strong> is your email address. Orders you placed with it as a guest will then appear in your account."
msgstr "Potwierdź, że <strong>{customer_email}</strong> to Twój adres e-mail. Zamówienia złożone z jego użyciem jako gość pojawią się wtedy w Twoim koncie."

msgid "Confirm email address"
msgstr "Potwierdź adres e-mail"

msgid "If you did not ask for this, simply ignore this email."
msgstr "Jeśli to nie Ty, po prostu zignoruj tę wiadomość."

msgid "Your {site_name} password was changed"
msgstr "Hasło do {site_name} zostało zmienione"

msgid "Your password was changed"
msgstr "Twoje hasło zostało zmienione"

msgid "A confirmation for your security."
msgstr "Potwierdzenie dla Twojego bezpieczeństwa."

msgid "This is a confirmation that the password of your account <strong>{user_login}</strong> at {site_name} was just changed."
msgstr "Potwierdzamy, że hasło do Twojego konta <strong>{user_login}</strong> w {site_name} zostało właśnie zmienione."

msgid "If you did not change it, please contact us right away at {store_email}."
msgstr "Jeśli ta zmiana nie pochodzi od Ciebie, skontaktuj się z nami od razu pod adresem {store_email}."

msgid "Your {site_name} email address was changed"
msgstr "Adres e-mail w {site_name} został zmieniony"

msgid "Your email address was changed"
msgstr "Twój adres e-mail został zmieniony"

msgid "This is a confirmation that the email address of your account at {site_name} was changed to <strong>{new_email}</strong>."
msgstr "Potwierdzamy, że adres e-mail Twojego konta w {site_name} został zmieniony na <strong>{new_email}</strong>."

msgid "Confirm your new email address for {site_name}"
msgstr "Potwierdź nowy adres e-mail dla {site_name}"

msgid "Confirm your new email address"
msgstr "Potwierdź nowy adres e-mail"

msgid "One click to confirm your new address."
msgstr "Jedno kliknięcie, aby potwierdzić nowy adres."

msgid "You asked to change the email address of your account at {site_name} to <strong>{new_email}</strong>. Please confirm it with the button below."
msgstr "Otrzymaliśmy prośbę o zmianę adresu e-mail Twojego konta w {site_name} na <strong>{new_email}</strong>. Potwierdź go przyciskiem poniżej."

msgid "Confirm new email address"
msgstr "Potwierdź nowy adres e-mail"

msgid "Please confirm your request: {request_type}"
msgstr "Potwierdź swoją prośbę: {request_type}"

msgid "Please confirm your request"
msgstr "Potwierdź swoją prośbę"

msgid "We received a request to do the following with your personal data at {site_name}: <strong>{request_type}</strong>."
msgstr "Otrzymaliśmy prośbę dotyczącą Twoich danych osobowych w {site_name}: <strong>{request_type}</strong>."

msgid "Confirm request"
msgstr "Potwierdź prośbę"

msgid "Your personal data from {site_name}"
msgstr "Twoje dane osobowe z {site_name}"

msgid "Your personal data is ready"
msgstr "Twoje dane osobowe są gotowe"

msgid "Download it before {expires_date}."
msgstr "Pobierz je przed {expires_date}."

msgid "The export of your personal data you asked for is ready."
msgstr "Zamówiony eksport Twoich danych osobowych jest gotowy."

msgid "Download your data"
msgstr "Pobierz dane"

msgid "For your privacy, the link works until {expires_date}."
msgstr "Dla Twojej prywatności link działa do {expires_date}."

msgid "Your personal data at {site_name} has been erased"
msgstr "Twoje dane osobowe w {site_name} zostały usunięte"

msgid "Your request is complete"
msgstr "Twoja prośba została zrealizowana"

msgid "We have erased your personal data."
msgstr "Usunęliśmy Twoje dane osobowe."

msgid "Your request to erase your personal data at {site_name} has been carried out."
msgstr "Twoja prośba o usunięcie danych osobowych w {site_name} została zrealizowana."

msgid "You can read more about how we handle personal data in our <a href=\"{privacy_policy_url}\">privacy policy</a>."
msgstr "Więcej o tym, jak postępujemy z danymi osobowymi, przeczytasz w naszej <a href=\"{privacy_policy_url}\">polityce prywatności</a>."

msgid "[{site_name}] New order #{order_number}"
msgstr "[{site_name}] Nowe zamówienie #{order_number}"

msgid "New order #{order_number}"
msgstr "Nowe zamówienie #{order_number}"

msgid "{customer_name} · {order_total}"
msgstr "{customer_name} · {order_total}"

msgid "You have received a new order from <strong>{customer_name}</strong>."
msgstr "Nowe zamówienie od <strong>{customer_name}</strong>."

msgid "[{site_name}] Order #{order_number} has been cancelled"
msgstr "[{site_name}] Zamówienie #{order_number} zostało anulowane"

msgid "Order cancelled: #{order_number}"
msgstr "Zamówienie anulowane: #{order_number}"

msgid "Order <strong>#{order_number}</strong> from {customer_name} has been cancelled."
msgstr "Zamówienie <strong>#{order_number}</strong> od {customer_name} zostało anulowane."

msgid "[{site_name}] Payment failed for order #{order_number}"
msgstr "[{site_name}] Płatność nie powiodła się dla zamówienia #{order_number}"

msgid "Payment failed: #{order_number}"
msgstr "Płatność nie powiodła się: #{order_number}"

msgid "The payment for order <strong>#{order_number}</strong> from {customer_name} failed. The order was:"
msgstr "Płatność za zamówienie <strong>#{order_number}</strong> od {customer_name} nie powiodła się. Zamówienie zawierało:"
