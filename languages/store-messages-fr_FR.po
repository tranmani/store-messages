# Store Messages fr_FR translation (customer-facing email texts).
msgid ""
msgstr ""
"Project-Id-Version: Store Messages 1.2.2\n"
"Language: fr_FR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: store-messages\n"

msgid "Hi {first_name},"
msgstr "Bonjour {first_name},"

msgid "Thank you for shopping with us,"
msgstr "Merci d’avoir fait vos achats chez nous,"

msgid "Tracking"
msgstr "Suivi"

msgid "Track your package"
msgstr "Suivre votre colis"

msgid "Your order"
msgstr "Votre commande"

msgid "Your order #{order_number} is on its way"
msgstr "Votre commande #{order_number} est en route"

msgid "Your order is on its way"
msgstr "Votre commande est en route"

msgid "Track your package: {carrier} {tracking_number}"
msgstr "Suivez votre colis : {carrier} {tracking_number}"

msgid "Good news: your order <strong>#{order_number}</strong> has been shipped and is on its way to you."
msgstr "Bonne nouvelle : votre commande <strong>#{order_number}</strong> a été expédiée et est en route vers vous."

msgid "Tracking can take up to 24 hours to show the first update."
msgstr "La première mise à jour du suivi peut prendre jusqu’à 24 heures."

msgid "In this parcel"
msgstr "Dans ce colis"

msgid "Shipping to"
msgstr "Livraison à"

msgid "Your order #{order_number} is ready for pickup"
msgstr "Votre commande #{order_number} est prête à être retirée"

msgid "Ready for pickup"
msgstr "Prête à être retirée"

msgid "Your order is waiting for you at {site_name}."
msgstr "Votre commande vous attend chez {site_name}."

msgid "Your order <strong>#{order_number}</strong> is packed and ready for you to collect."
msgstr "Votre commande <strong>#{order_number}</strong> est emballée et prête à être retirée."

msgid "Pickup address"
msgstr "Adresse de retrait"

msgid "Please bring your order number with you."
msgstr "Merci de vous munir de votre numéro de commande."

msgid "An update about your order #{order_number}"
msgstr "Des nouvelles de votre commande #{order_number}"

msgid "An update about your order"
msgstr "Des nouvelles de votre commande"

msgid "One item in your order is unavailable."
msgstr "Un article de votre commande n’est pas disponible."

msgid "Thank you for your order <strong>#{order_number}</strong>. Unfortunately, one of the items you ordered is currently out of stock and we are unable to send it."
msgstr "Merci pour votre commande <strong>#{order_number}</strong>. Malheureusement, l’un des articles commandés est actuellement en rupture de stock et nous ne pouvons pas vous l’envoyer."

msgid "We have refunded that item to your original payment method. The rest of your order is being prepared as usual."
msgstr "Nous vous avons remboursé cet article sur votre moyen de paiement d’origine. Le reste de votre commande est préparé normalement."

msgid "Refunded: <strong>{refund_amount}</strong>. It can take a few business days to appear on your statement."
msgstr "Montant remboursé : <strong>{refund_amount}</strong>. Il peut s’écouler quelques jours ouvrables avant qu’il n’apparaisse sur votre relevé."

msgid "We are very sorry for the inconvenience. Simply reply to this email if you have any questions."
msgstr "Nous sommes vraiment désolés pour ce désagrément. Pour toute question, il vous suffit de répondre à cet e-mail."

msgid "Your refund for order #{order_number}"
msgstr "Votre remboursement pour la commande #{order_number}"

msgid "Your refund is on its way"
msgstr "Votre remboursement est en cours"

msgid "Refund of {refund_amount} for order #{order_number}."
msgstr "Remboursement de {refund_amount} pour la commande #{order_number}."

msgid "We have processed a refund of <strong>{refund_amount}</strong> for your order <strong>#{order_number}</strong>."
msgstr "Nous avons effectué un remboursement de <strong>{refund_amount}</strong> pour votre commande <strong>#{order_number}</strong>."

msgid "Reason: {refund_reason}"
msgstr "Motif : {refund_reason}"

msgid "Depending on your bank, it can take a few business days for the money to reach your account."
msgstr "Selon votre banque, il peut s’écouler quelques jours ouvrables avant que l’argent n’arrive sur votre compte."

msgid "Your order #{order_number} needs a little more time"
msgstr "Votre commande #{order_number} a besoin d’un peu plus de temps"

msgid "A short delay"
msgstr "Un léger retard"

msgid "An update on when your order will ship."
msgstr "Des nouvelles sur l’expédition de votre commande."

msgid "We wanted to let you know that your order <strong>#{order_number}</strong> is taking a little longer than usual to prepare."
msgstr "Nous tenions à vous informer que la préparation de votre commande <strong>#{order_number}</strong> prend un peu plus de temps que d’habitude."

msgid "We will send you the tracking link as soon as it ships. Thank you for your patience!"
msgstr "Nous vous enverrons le lien de suivi dès son expédition. Merci de votre patience !"

msgid "Complete your order #{order_number}"
msgstr "Finalisez votre commande #{order_number}"

msgid "Your order is waiting"
msgstr "Votre commande vous attend"

msgid "Finish your payment to confirm order #{order_number}."
msgstr "Finalisez votre paiement pour confirmer la commande #{order_number}."

msgid "Your order <strong>#{order_number}</strong> ({order_total}) is not paid yet. You can complete the payment securely with the button below."
msgstr "Votre commande <strong>#{order_number}</strong> ({order_total}) n’est pas encore payée. Vous pouvez finaliser le paiement en toute sécurité grâce au bouton ci-dessous."

msgid "Complete payment"
msgstr "Finaliser le paiement"

msgid "How are you enjoying your order, {first_name}?"
msgstr "Votre commande vous plaît-elle, {first_name} ?"

msgid "How did we do?"
msgstr "Votre avis nous intéresse"

msgid "Your feedback helps other customers."
msgstr "Votre avis aide les autres clientes et clients."

msgid "We hope you are enjoying your order. Would you take a minute to tell other customers what you think? It means a lot to a small business like ours."
msgstr "Nous espérons que votre commande vous plaît. Auriez-vous une minute pour partager votre avis avec les autres clients ? Cela compte beaucoup pour une petite entreprise comme la nôtre."

msgid "Leave a review"
msgstr "Laisser un avis"

msgid "A message about your order #{order_number}"
msgstr "Un message concernant votre commande #{order_number}"

msgid "A message from {site_name}"
msgstr "Un message de {site_name}"

msgid "A note about your order #{order_number}"
msgstr "Une note concernant votre commande #{order_number}"

msgid "A note about your order"
msgstr "Une note concernant votre commande"

msgid "Order #{order_number} · placed {order_date}"
msgstr "Commande #{order_number} · passée le {order_date}"

msgid "Welcome to {site_name}{if coupon_code}: your {coupon_amount} code{/if}"
msgstr "Bienvenue chez {site_name}{if coupon_code} : votre code de réduction de {coupon_amount}{/if}"

msgid "Thanks for signing up!"
msgstr "Merci pour votre inscription !"

msgid "Your personal code for {coupon_amount} off your first order is inside."
msgstr "À l’intérieur : votre code personnel de {coupon_amount} de réduction sur votre première commande."

msgid "Good to have you with us."
msgstr "Ravis de vous compter parmi nous."

msgid "Hello,"
msgstr "Bonjour,"

msgid "Welcome to {site_name}! From now on you are the first to hear about new products and offers."
msgstr "Bienvenue chez {site_name} ! Vous serez désormais les premiers informés de nos nouveautés et de nos offres."

msgid "Your personal code"
msgstr "Votre code personnel"

msgid "{coupon_amount} off your first order{if coupon_expires}, valid until {coupon_expires}{/if}. Enter it at checkout."
msgstr "{coupon_amount} de réduction sur votre première commande{if coupon_expires}, valable jusqu’au {coupon_expires}{/if}. Saisissez-le lors de la validation de commande."

msgid "Start shopping"
msgstr "Découvrir la boutique"

msgid "Our bestsellers"
msgstr "Nos meilleures ventes"

msgid "Please confirm your subscription to {site_name}"
msgstr "Veuillez confirmer votre inscription à {site_name}"

msgid "One more step"
msgstr "Encore une étape"

msgid "Confirm your email address to start receiving our news."
msgstr "Confirmez votre adresse e-mail pour recevoir nos actualités."

msgid "Please confirm that you want to receive emails from {site_name}."
msgstr "Veuillez confirmer que vous souhaitez recevoir les e-mails de {site_name}."

msgid "Yes, subscribe me"
msgstr "Oui, je m’inscris"

msgid "If you did not sign up, simply ignore this email: you will not hear from us."
msgstr "Si vous ne vous êtes pas inscrit, ignorez simplement cet e-mail : vous ne recevrez rien de notre part."

msgid "Questions? Just reply to this email."
msgstr "Des questions ? Répondez simplement à cet e-mail."

msgid "Unsubscribe"
msgstr "Se désinscrire"

msgid "Your {site_name} order #{order_number} has been received"
msgstr "Votre commande #{order_number} chez {site_name} a bien été reçue"

msgid "Thank you for your order"
msgstr "Merci pour votre commande"

msgid "We have received your order and are getting it ready."
msgstr "Nous avons bien reçu votre commande et nous la préparons."

msgid "We have received your order <strong>#{order_number}</strong> and are now getting it ready. We will let you know as soon as it is on its way."
msgstr "Nous avons bien reçu votre commande <strong>#{order_number}</strong> et nous la préparons. Nous vous informerons dès qu’elle sera en route."

msgid "Your order is on hold until we receive your payment."
msgstr "Votre commande est en attente de votre paiement."

msgid "Thank you for your order <strong>#{order_number}</strong>. It is on hold until we confirm that your payment has been received."
msgstr "Merci pour votre commande <strong>#{order_number}</strong>. Elle est en attente jusqu’à la confirmation de la réception de votre paiement."

msgid "Your {site_name} order #{order_number} is complete"
msgstr "Votre commande #{order_number} chez {site_name} est terminée"

msgid "Your order is complete"
msgstr "Votre commande est terminée"

msgid "We have finished processing your order."
msgstr "Nous avons fini de traiter votre commande."

msgid "We have finished processing your order <strong>#{order_number}</strong>."
msgstr "Nous avons fini de traiter votre commande <strong>#{order_number}</strong>."

msgid "Your {site_name} order #{order_number} has been partially refunded"
msgstr "Votre commande #{order_number} chez {site_name} a été partiellement remboursée"

msgid "Your {site_name} order #{order_number} has been refunded"
msgstr "Votre commande #{order_number} chez {site_name} a été remboursée"

msgid "Partial refund issued"
msgstr "Remboursement partiel effectué"

msgid "Your order has been refunded"
msgstr "Votre commande a été remboursée"

msgid "We have refunded <strong>{refund_amount}</strong> of your order <strong>#{order_number}</strong>."
msgstr "Nous vous avons remboursé <strong>{refund_amount}</strong> sur votre commande <strong>#{order_number}</strong>."

msgid "Your order <strong>#{order_number}</strong> has been refunded in full: <strong>{refund_amount}</strong>."
msgstr "Votre commande <strong>#{order_number}</strong> a été entièrement remboursée : <strong>{refund_amount}</strong>."

msgid "The money goes back to your original payment method. It can take a few business days to appear on your statement."
msgstr "Le montant est recrédité sur votre moyen de paiement d’origine. Il peut s’écouler quelques jours ouvrables avant qu’il n’apparaisse sur votre relevé."

msgid "Your {site_name} order #{order_number} was unsuccessful"
msgstr "Votre commande #{order_number} chez {site_name} n’a pas abouti"

msgid "Your payment did not go through"
msgstr "Votre paiement n’a pas abouti"

msgid "You can try again with another payment method."
msgstr "Vous pouvez réessayer avec un autre moyen de paiement."

msgid "Unfortunately, we could not complete your order <strong>#{order_number}</strong> because of a problem with the payment."
msgstr "Malheureusement, nous n’avons pas pu finaliser votre commande <strong>#{order_number}</strong> en raison d’un problème de paiement."

msgid "If you would still like to place it, you can pay again, with another payment method if you like."
msgstr "Si vous souhaitez toujours la passer, vous pouvez payer à nouveau, avec un autre moyen de paiement si vous le souhaitez."

msgid "Pay for this order"
msgstr "Payer cette commande"

msgid "Your {site_name} order #{order_number} has been cancelled"
msgstr "Votre commande #{order_number} chez {site_name} a été annulée"

msgid "Your order has been cancelled"
msgstr "Votre commande a été annulée"

msgid "Order #{order_number} has been cancelled."
msgstr "La commande #{order_number} a été annulée."

msgid "We are writing to let you know that your order <strong>#{order_number}</strong> has been cancelled."
msgstr "Nous vous informons que votre commande <strong>#{order_number}</strong> a été annulée."

msgid "Invoice for order #{order_number} at {site_name}"
msgstr "Facture de la commande #{order_number} chez {site_name}"

msgid "Details of your order #{order_number}"
msgstr "Détails de votre commande #{order_number}"

msgid "Your invoice"
msgstr "Votre facture"

msgid "Your order details"
msgstr "Les détails de votre commande"

msgid "Order #{order_number} · {order_total}"
msgstr "Commande #{order_number} · {order_total}"

msgid "An order has been created for you at {site_name}. You can pay for it with the button below."
msgstr "Une commande a été créée pour vous chez {site_name}. Vous pouvez la régler avec le bouton ci-dessous."

msgid "Here are the details of your order <strong>#{order_number}</strong>, placed on {order_date}."
msgstr "Voici les détails de votre commande <strong>#{order_number}</strong>, passée le {order_date}."

msgid "Reset your {site_name} password"
msgstr "Réinitialisez votre mot de passe {site_name}"

msgid "Reset your password"
msgstr "Réinitialisez votre mot de passe"

msgid "Someone asked for a new password for your account."
msgstr "Quelqu’un a demandé un nouveau mot de passe pour votre compte."

msgid "Someone asked for a new password for the account <strong>{user_login}</strong> at {site_name}."
msgstr "Quelqu’un a demandé un nouveau mot de passe pour le compte <strong>{user_login}</strong> chez {site_name}."

msgid "Choose a new password"
msgstr "Choisir un nouveau mot de passe"

msgid "If you did not ask for this, simply ignore this email: your password stays the same."
msgstr "Si vous n’êtes pas à l’origine de cette demande, ignorez simplement cet e-mail : votre mot de passe reste inchangé."

msgid "Your account at {site_name} has been created"
msgstr "Votre compte chez {site_name} a été créé"

msgid "Welcome to {site_name}"
msgstr "Bienvenue chez {site_name}"

msgid "Your account is ready."
msgstr "Votre compte est prêt."

msgid "Thank you for creating an account at {site_name}. Your username is <strong>{user_login}</strong>."
msgstr "Merci d’avoir créé un compte chez {site_name}. Votre nom d’utilisateur est <strong>{user_login}</strong>."

msgid "Choose your password with the button below to start using your account."
msgstr "Choisissez votre mot de passe avec le bouton ci-dessous pour commencer à utiliser votre compte."

msgid "Choose your password"
msgstr "Choisir mon mot de passe"

msgid "In your account you can see your orders, change your addresses and your password."
msgstr "Dans votre compte, vous pouvez consulter vos commandes, modifier vos adresses et votre mot de passe."

msgid "Go to my account"
msgstr "Accéder à mon compte"

msgid "Confirm your email address for {site_name}"
msgstr "Confirmez votre adresse e-mail pour {site_name}"

msgid "Confirm your email address"
msgstr "Confirmez votre adresse e-mail"

msgid "One click to link your past orders to your account."
msgstr "Un clic pour relier vos commandes passées à votre compte."

msgid "Please confirm that <strong>{customer_email}</strong> is your email address. Orders you placed with it as a guest will then appear in your account."
msgstr "Veuillez confirmer que <strong>{customer_email}</strong> est bien votre adresse e-mail. Les commandes passées avec cette adresse en tant qu’invité apparaîtront alors dans votre compte."

msgid "Confirm email address"
msgstr "Confirmer l’adresse e-mail"

msgid "If you did not ask for this, simply ignore this email."
msgstr "Si vous n’êtes pas à l’origine de cette demande, ignorez simplement cet e-mail."

msgid "Your {site_name} password was changed"
msgstr "Votre mot de passe {site_name} a été modifié"

msgid "Your password was changed"
msgstr "Votre mot de passe a été modifié"

msgid "A confirmation for your security."
msgstr "Une confirmation pour votre sécurité."

msgid "This is a confirmation that the password of your account <strong>{user_login}</strong> at {site_name} was just changed."
msgstr "Nous vous confirmons que le mot de passe de votre compte <strong>{user_login}</strong> chez {site_name} vient d’être modifié."

msgid "If you did not change it, please contact us right away at {store_email}."
msgstr "Si vous n’êtes pas à l’origine de cette modification, contactez-nous sans attendre à l’adresse {store_email}."

msgid "Your {site_name} email address was changed"
msgstr "Votre adresse e-mail {site_name} a été modifiée"

msgid "Your email address was changed"
msgstr "Votre adresse e-mail a été modifiée"

msgid "This is a confirmation that the email address of your account at {site_name} was changed to <strong>{new_email}</strong>."
msgstr "Nous vous confirmons que l’adresse e-mail de votre compte chez {site_name} a été remplacée par <strong>{new_email}</strong>."

msgid "Confirm your new email address for {site_name}"
msgstr "Confirmez votre nouvelle adresse e-mail pour {site_name}"

msgid "Confirm your new email address"
msgstr "Confirmez votre nouvelle adresse e-mail"

msgid "One click to confirm your new address."
msgstr "Un clic pour confirmer votre nouvelle adresse."

msgid "You asked to change the email address of your account at {site_name} to <strong>{new_email}</strong>. Please confirm it with the button below."
msgstr "Vous avez demandé à remplacer l’adresse e-mail de votre compte chez {site_name} par <strong>{new_email}</strong>. Veuillez la confirmer avec le bouton ci-dessous."

msgid "Confirm new email address"
msgstr "Confirmer la nouvelle adresse e-mail"

msgid "Please confirm your request: {request_type}"
msgstr "Veuillez confirmer votre demande : {request_type}"

msgid "Please confirm your request"
msgstr "Veuillez confirmer votre demande"

msgid "We received a request to do the following with your personal data at {site_name}: <strong>{request_type}</strong>."
msgstr "Nous avons reçu une demande concernant vos données personnelles chez {site_name} : <strong>{request_type}</strong>."

msgid "Confirm request"
msgstr "Confirmer la demande"

msgid "Your personal data from {site_name}"
msgstr "Vos données personnelles de {site_name}"

msgid "Your personal data is ready"
msgstr "Vos données personnelles sont prêtes"

msgid "Download it before {expires_date}."
msgstr "Téléchargez-les avant le {expires_date}."

msgid "The export of your personal data you asked for is ready."
msgstr "L’export de vos données personnelles que vous avez demandé est prêt."

msgid "Download your data"
msgstr "Télécharger mes données"

msgid "For your privacy, the link works until {expires_date}."
msgstr "Pour votre sécurité, le lien est valable jusqu’au {expires_date}."

msgid "Your personal data at {site_name} has been erased"
msgstr "Vos données personnelles chez {site_name} ont été effacées"

msgid "Your request is complete"
msgstr "Votre demande a été traitée"

msgid "We have erased your personal data."
msgstr "Nous avons effacé vos données personnelles."

msgid "Your request to erase your personal data at {site_name} has been carried out."
msgstr "Votre demande d’effacement de vos données personnelles chez {site_name} a été exécutée."

msgid "You can read more about how we handle personal data in our <a href=\"{privacy_policy_url}\">privacy policy</a>."
msgstr "Pour en savoir plus sur la façon dont nous traitons les données personnelles, consultez notre <a href=\"{privacy_policy_url}\">politique de confidentialité</a>."

msgid "[{site_name}] New order #{order_number}"
msgstr "[{site_name}] Nouvelle commande #{order_number}"

msgid "New order #{order_number}"
msgstr "Nouvelle commande #{order_number}"

msgid "{customer_name} · {order_total}"
msgstr "{customer_name} · {order_total}"

msgid "You have received a new order from <strong>{customer_name}</strong>."
msgstr "Vous avez reçu une nouvelle commande de <strong>{customer_name}</strong>."

msgid "[{site_name}] Order #{order_number} has been cancelled"
msgstr "[{site_name}] La commande #{order_number} a été annulée"

msgid "Order cancelled: #{order_number}"
msgstr "Commande annulée : #{order_number}"

msgid "Order <strong>#{order_number}</strong> from {customer_name} has been cancelled."
msgstr "La commande <strong>#{order_number}</strong> de {customer_name} a été annulée."

msgid "[{site_name}] Payment failed for order #{order_number}"
msgstr "[{site_name}] Échec du paiement de la commande #{order_number}"

msgid "Payment failed: #{order_number}"
msgstr "Échec du paiement : #{order_number}"

msgid "The payment for order <strong>#{order_number}</strong> from {customer_name} failed. The order was:"
msgstr "Le paiement de la commande <strong>#{order_number}</strong> de {customer_name} a échoué. La commande contenait :"
