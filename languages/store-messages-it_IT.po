# Store Messages it_IT translation (customer-facing email texts).
msgid ""
msgstr ""
"Project-Id-Version: Store Messages 1.2.2\n"
"Language: it_IT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: store-messages\n"

msgid "Hi {first_name},"
msgstr "Ciao {first_name},"

msgid "Thank you for shopping with us,"
msgstr "Grazie per aver acquistato da noi,"

msgid "Tracking"
msgstr "Tracciamento"

msgid "Track your package"
msgstr "Traccia il tuo pacco"

msgid "Your order"
msgstr "Il tuo ordine"

msgid "Your order #{order_number} is on its way"
msgstr "Il tuo ordine #{order_number} è in viaggio"

msgid "Your order is on its way"
msgstr "Il tuo ordine è in viaggio"

msgid "Track your package: {carrier} {tracking_number}"
msgstr "Traccia il tuo pacco: {carrier} {tracking_number}"

msgid "Good news: your order <strong>#{order_number}</strong> has been shipped and is on its way to you."
msgstr "Buone notizie: il tuo ordine <strong>#{order_number}</strong> è stato spedito ed è in viaggio verso di te."

msgid "Tracking can take up to 24 hours to show the first update."
msgstr "Il tracciamento può impiegare fino a 24 ore per mostrare il primo aggiornamento."

msgid "In this parcel"
msgstr "In questo pacco"

msgid "Shipping to"
msgstr "Spedizione a"

msgid "Your order #{order_number} is ready for pickup"
msgstr "Il tuo ordine #{order_number} è pronto per il ritiro"

msgid "Ready for pickup"
msgstr "Pronto per il ritiro"

msgid "Your order is waiting for you at {site_name}."
msgstr "Il tuo ordine ti aspetta da {site_name}."

msgid "Your order <strong>#{order_number}</strong> is packed and ready for you to collect."
msgstr "Il tuo ordine <strong>#{order_number}</strong> è imballato e pronto per essere ritirato."

msgid "Pickup address"
msgstr "Indirizzo di ritiro"

msgid "Please bring your order number with you."
msgstr "Porta con te il numero dell'ordine."

msgid "An update about your order #{order_number}"
msgstr "Un aggiornamento sul tuo ordine #{order_number}"

msgid "An update about your order"
msgstr "Un aggiornamento sul tuo ordine"

msgid "One item in your order is unavailable."
msgstr "Un articolo del tuo ordine non è disponibile."

msgid "Thank you for your order <strong>#{order_number}</strong>. Unfortunately, one of the items you ordered is currently out of stock and we are unable to send it."
msgstr "Grazie per il tuo ordine <strong>#{order_number}</strong>. Purtroppo uno degli articoli che hai ordinato è al momento esaurito e non possiamo spedirlo."

msgid "We have refunded that item to your original payment method. The rest of your order is being prepared as usual."
msgstr "Ti abbiamo rimborsato l'articolo sul metodo di pagamento che hai utilizzato. Il resto del tuo ordine viene preparato come di consueto."

msgid "Refunded: <strong>{refund_amount}</strong>. It can take a few business days to appear on your statement."
msgstr "Rimborsato: <strong>{refund_amount}</strong>. Potrebbero volerci alcuni giorni lavorativi prima che compaia sul tuo estratto conto."

msgid "We are very sorry for the inconvenience. Simply reply to this email if you have any questions."
msgstr "Ci scusiamo molto per l'inconveniente. Se hai domande, rispondi semplicemente a questa email."

msgid "Your refund for order #{order_number}"
msgstr "Il tuo rimborso per l'ordine #{order_number}"

msgid "Your refund is on its way"
msgstr "Il tuo rimborso è in arrivo"

msgid "Refund of {refund_amount} for order #{order_number}."
msgstr "Rimborso di {refund_amount} per l'ordine #{order_number}."

msgid "We have processed a refund of <strong>{refund_amount}</strong> for your order <strong>#{order_number}</strong>."
msgstr "Abbiamo elaborato un rimborso di <strong>{refund_amount}</strong> per il tuo ordine <strong>#{order_number}</strong>."

msgid "Reason: {refund_reason}"
msgstr "Motivo: {refund_reason}"

msgid "Depending on your bank, it can take a few business days for the money to reach your account."
msgstr "A seconda della tua banca, potrebbero volerci alcuni giorni lavorativi prima che il denaro arrivi sul tuo conto."

msgid "Your order #{order_number} needs a little more time"
msgstr "Il tuo ordine #{order_number} richiede un po' più di tempo"

msgid "A short delay"
msgstr "Un breve ritardo"

msgid "An update on when your order will ship."
msgstr "Un aggiornamento su quando verrà spedito il tuo ordine."

msgid "We wanted to let you know that your order <strong>#{order_number}</strong> is taking a little longer than usual to prepare."
msgstr "Volevamo informarti che la preparazione del tuo ordine <strong>#{order_number}</strong> sta richiedendo un po' più tempo del solito."

msgid "We will send you the tracking link as soon as it ships. Thank you for your patience!"
msgstr "Ti invieremo il link di tracciamento non appena verrà spedito. Grazie per la pazienza!"

msgid "Complete your order #{order_number}"
msgstr "Completa il tuo ordine #{order_number}"

msgid "Your order is waiting"
msgstr "Il tuo ordine ti aspetta"

msgid "Finish your payment to confirm order #{order_number}."
msgstr "Completa il pagamento per confermare l'ordine #{order_number}."

msgid "Your order <strong>#{order_number}</strong> ({order_total}) is not paid yet. You can complete the payment securely with the button below."
msgstr "Il tuo ordine <strong>#{order_number}</strong> ({order_total}) non è ancora stato pagato. Puoi completare il pagamento in modo sicuro con il pulsante qui sotto."

msgid "Complete payment"
msgstr "Completa il pagamento"

msgid "How are you enjoying your order, {first_name}?"
msgstr "Come ti trovi con il tuo ordine, {first_name}?"

msgid "How did we do?"
msgstr "Com'è andata?"

msgid "Your feedback helps other customers."
msgstr "La tua opinione aiuta gli altri clienti."

msgid "We hope you are enjoying your order. Would you take a minute to tell other customers what you think? It means a lot to a small business like ours."
msgstr "Speriamo che il tuo ordine ti stia piacendo. Ti va di dedicare un minuto a raccontare agli altri clienti cosa ne pensi? Per una piccola attività come la nostra significa molto."

msgid "Leave a review"
msgstr "Lascia una recensione"

msgid "A message about your order #{order_number}"
msgstr "Un messaggio sul tuo ordine #{order_number}"

msgid "A message from {site_name}"
msgstr "Un messaggio da {site_name}"

msgid "A note about your order #{order_number}"
msgstr "Una nota sul tuo ordine #{order_number}"

msgid "A note about your order"
msgstr "Una nota sul tuo ordine"

msgid "Order #{order_number} · placed {order_date}"
msgstr "Ordine #{order_number} · effettuato il {order_date}"

msgid "Welcome to {site_name}{if coupon_code}: your {coupon_amount} code{/if}"
msgstr "Ti diamo il benvenuto su {site_name}{if coupon_code}: il tuo codice da {coupon_amount}{/if}"

msgid "Thanks for signing up!"
msgstr "Grazie per l'iscrizione!"

msgid "Your personal code for {coupon_amount} off your first order is inside."
msgstr "All'interno trovi il tuo codice personale per {coupon_amount} di sconto sul primo ordine."

msgid "Good to have you with us."
msgstr "Che bello averti con noi."

msgid "Hello,"
msgstr "Ciao,"

msgid "Welcome to {site_name}! From now on you are the first to hear about new products and offers."
msgstr "Ti diamo il benvenuto su {site_name}! D'ora in poi sarai tra i primi a scoprire nuovi prodotti e offerte."

msgid "Your personal code"
msgstr "Il tuo codice personale"

msgid "{coupon_amount} off your first order{if coupon_expires}, valid until {coupon_expires}{/if}. Enter it at checkout."
msgstr "{coupon_amount} di sconto sul tuo primo ordine{if coupon_expires}, valido fino al {coupon_expires}{/if}. Inseriscilo al momento del pagamento."

msgid "Start shopping"
msgstr "Inizia lo shopping"

msgid "Our bestsellers"
msgstr "I nostri bestseller"

msgid "Please confirm your subscription to {site_name}"
msgstr "Conferma la tua iscrizione a {site_name}"

msgid "One more step"
msgstr "Ancora un passo"

msgid "Confirm your email address to start receiving our news."
msgstr "Conferma il tuo indirizzo email per iniziare a ricevere le nostre novità."

msgid "Please confirm that you want to receive emails from {site_name}."
msgstr "Conferma che desideri ricevere email da {site_name}."

msgid "Yes, subscribe me"
msgstr "Sì, iscrivimi"

msgid "If you did not sign up, simply ignore this email: you will not hear from us."
msgstr "Se non ti sei iscritto, ignora semplicemente questa email: non riceverai altri messaggi da noi."

msgid "Questions? Just reply to this email."
msgstr "Domande? Rispondi semplicemente a questa email."

msgid "Unsubscribe"
msgstr "Annulla l'iscrizione"

msgid "Your {site_name} order #{order_number} has been received"
msgstr "Il tuo ordine #{order_number} su {site_name} è stato ricevuto"

msgid "Thank you for your order"
msgstr "Grazie per il tuo ordine"

msgid "We have received your order and are getting it ready."
msgstr "Abbiamo ricevuto il tuo ordine e lo stiamo preparando."

msgid "We have received your order <strong>#{order_number}</strong> and are now getting it ready. We will let you know as soon as it is on its way."
msgstr "Abbiamo ricevuto il tuo ordine <strong>#{order_number}</strong> e lo stiamo preparando. Ti avviseremo non appena sarà in viaggio."

msgid "Your order is on hold until we receive your payment."
msgstr "Il tuo ordine è in attesa del pagamento."

msgid "Thank you for your order <strong>#{order_number}</strong>. It is on hold until we confirm that your payment has been received."
msgstr "Grazie per il tuo ordine <strong>#{order_number}</strong>. È in attesa finché non confermiamo di aver ricevuto il pagamento."

msgid "Your {site_name} order #{order_number} is complete"
msgstr "Il tuo ordine #{order_number} su {site_name} è completato"

msgid "Your order is complete"
msgstr "Il tuo ordine è completato"

msgid "We have finished processing your order."
msgstr "Abbiamo terminato l'elaborazione del tuo ordine."

msgid "We have finished processing your order <strong>#{order_number}</strong>."
msgstr "Abbiamo terminato l'elaborazione del tuo ordine <strong>#{order_number}</strong>."

msgid "Your {site_name} order #{order_number} has been partially refunded"
msgstr "Il tuo ordine #{order_number} su {site_name} è stato rimborsato parzialmente"

msgid "Your {site_name} order #{order_number} has been refunded"
msgstr "Il tuo ordine #{order_number} su {site_name} è stato rimborsato"

msgid "Partial refund issued"
msgstr "Rimborso parziale effettuato"

msgid "Your order has been refunded"
msgstr "Il tuo ordine è stato rimborsato"

msgid "We have refunded <strong>{refund_amount}</strong> of your order <strong>#{order_number}</strong>."
msgstr "Ti abbiamo rimborsato <strong>{refund_amount}</strong> del tuo ordine <strong>#{order_number}</strong>."

msgid "Your order <strong>#{order_number}</strong> has been refunded in full: <strong>{refund_amount}</strong>."
msgstr "Il tuo ordine <strong>#{order_number}</strong> è stato rimborsato per intero: <strong>{refund_amount}</strong>."

msgid "The money goes back to your original payment method. It can take a few business days to appear on your statement."
msgstr "L'importo torna sul tuo metodo di pagamento originale. Potrebbero volerci alcuni giorni lavorativi prima che compaia sul tuo estratto conto."

msgid "Your {site_name} order #{order_number} was unsuccessful"
msgstr "Il tuo ordine #{order_number} su {site_name} non è andato a buon fine"

msgid "Your payment did not go through"
msgstr "Il pagamento non è andato a buon fine"

msgid "You can try again with another payment method."
msgstr "Puoi riprovare con un altro metodo di pagamento."

msgid "Unfortunately, we could not complete your order <strong>#{order_number}</strong> because of a problem with the payment."
msgstr "Purtroppo non abbiamo potuto completare il tuo ordine <strong>#{order_number}</strong> a causa di un problema con il pagamento."

msgid "If you would still like to place it, you can pay again, with another payment method if you like."
msgstr "Se desideri ancora effettuarlo, puoi pagare di nuovo, anche con un altro metodo di pagamento."

msgid "Pay for this order"
msgstr "Paga questo ordine"

msgid "Your {site_name} order #{order_number} has been cancelled"
msgstr "Il tuo ordine #{order_number} su {site_name} è stato annullato"

msgid "Your order has been cancelled"
msgstr "Il tuo ordine è stato annullato"

msgid "Order #{order_number} has been cancelled."
msgstr "L'ordine #{order_number} è stato annullato."

msgid "We are writing to let you know that your order <strong>#{order_number}</strong> has been cancelled."
msgstr "Ti scriviamo per informarti che il tuo ordine <strong>#{order_number}</strong> è stato annullato."

msgid "Invoice for order #{order_number} at {site_name}"
msgstr "Fattura dell'ordine #{order_number} su {site_name}"

msgid "Details of your order #{order_number}"
msgstr "Dettagli del tuo ordine #{order_number}"

msgid "Your invoice"
msgstr "La tua fattura"

msgid "Your order details"
msgstr "I dettagli del tuo ordine"

msgid "Order #{order_number} · {order_total}"
msgstr "Ordine #{order_number} · {order_total}"

msgid "An order has been created for you at {site_name}. You can pay for it with the button below."
msgstr "È stato creato un ordine per te su {site_name}. Puoi pagarlo con il pulsante qui sotto."

msgid "Here are the details of your order <strong>#{order_number}</strong>, placed on {order_date}."
msgstr "Ecco i dettagli del tuo ordine <strong>#{order_number}</strong>, effettuato il {order_date}."

msgid "Reset your {site_name} password"
msgstr "Reimposta la tua password di {site_name}"

msgid "Reset your password"
msgstr "Reimposta la tua password"

msgid "Someone asked for a new password for your account."
msgstr "Qualcuno ha richiesto una nuova password per il tuo account."

msgid "Someone asked for a new password for the account <strong>{user_login}</strong> at {site_name}."
msgstr "Qualcuno ha richiesto una nuova password per l'account <strong>{user_login}</strong> su {site_name}."

msgid "Choose a new password"
msgstr "Scegli una nuova password"

msgid "If you did not ask for this, simply ignore this email: your password stays the same."
msgstr "Se la richiesta non è partita da te, ignora semplicemente questa email: la tua password resta invariata."

msgid "Your account at {site_name} has been created"
msgstr "Il tuo account su {site_name} è stato creato"

msgid "Welcome to {site_name}"
msgstr "Benvenuto su {site_name}"

msgid "Your account is ready."
msgstr "Il tuo account è pronto."

msgid "Thank you for creating an account at {site_name}. Your username is <strong>{user_login}</strong>."
msgstr "Grazie per aver creato un account su {site_name}. Il tuo nome utente è <strong>{user_login}</strong>."

msgid "Choose your password with the button below to start using your account."
msgstr "Scegli la tua password con il pulsante qui sotto per iniziare a usare il tuo account."

msgid "Choose your password"
msgstr "Scegli la tua password"

msgid "In your account you can see your orders, change your addresses and your password."
msgstr "Nel tuo account puoi vedere i tuoi ordini e modificare i tuoi indirizzi e la tua password."

msgid "Go to my account"
msgstr "Vai al mio account"

msgid "Confirm your email address for {site_name}"
msgstr "Conferma il tuo indirizzo email per {site_name}"

msgid "Confirm your email address"
msgstr "Conferma il tuo indirizzo email"

msgid "One click to link your past orders to your account."
msgstr "Un clic per collegare i tuoi ordini passati al tuo account."

msgid "Please confirm that <strong>{customer_email}</strong> is your email address. Orders you placed with it as a guest will then appear in your account."
msgstr "Conferma che <strong>{customer_email}</strong> è il tuo indirizzo email. Gli ordini effettuati con questo indirizzo come ospite compariranno poi nel tuo account."

msgid "Confirm email address"
msgstr "Conferma indirizzo email"

msgid "If you did not ask for this, simply ignore this email."
msgstr "Se la richiesta non è partita da te, ignora semplicemente questa email."

msgid "Your {site_name} password was changed"
msgstr "La tua password di {site_name} è stata modificata"

msgid "Your password was changed"
msgstr "La tua password è stata modificata"

msgid "A confirmation for your security."
msgstr "Una conferma per la tua sicurezza."

msgid "This is a confirmation that the password of your account <strong>{user_login}</strong> at {site_name} was just changed."
msgstr "Ti confermiamo che la password del tuo account <strong>{user_login}</strong> su {site_name} è stata appena modificata."

msgid "If you did not change it, please contact us right away at {store_email}."
msgstr "Se non l'hai modificata tu, contattaci subito all'indirizzo {store_email}."

msgid "Your {site_name} email address was changed"
msgstr "Il tuo indirizzo email di {site_name} è stato modificato"

msgid "Your email address was changed"
msgstr "Il tuo indirizzo email è stato modificato"

msgid "This is a confirmation that the email address of your account at {site_name} was changed to <strong>{new_email}</strong>."
msgstr "Ti confermiamo che l'indirizzo email del tuo account su {site_name} è stato modificato in <strong>{new_email}</strong>."

msgid "Confirm your new email address for {site_name}"
msgstr "Conferma il tuo nuovo indirizzo email per {site_name}"

msgid "Confirm your new email address"
msgstr "Conferma il tuo nuovo indirizzo email"

msgid "One click to confirm your new address."
msgstr "Un clic per confermare il tuo nuovo indirizzo."

msgid "You asked to change the email address of your account at {site_name} to <strong>{new_email}</strong>. Please confirm it with the button below."
msgstr "Hai chiesto di modificare l'indirizzo email del tuo account su {site_name} in <strong>{new_email}</strong>. Confermalo con il pulsante qui sotto."

msgid "Confirm new email address"
msgstr "Conferma nuovo indirizzo email"

msgid "Please confirm your request: {request_type}"
msgstr "Conferma la tua richiesta: {request_type}"

msgid "Please confirm your request"
msgstr "Conferma la tua richiesta"

msgid "We received a request to do the following with your personal data at {site_name}: <strong>{request_type}</strong>."
msgstr "Abbiamo ricevuto una richiesta relativa ai tuoi dati personali su {site_name}: <strong>{request_type}</strong>."

msgid "Confirm request"
msgstr "Conferma richiesta"

msgid "Your personal data from {site_name}"
msgstr "I tuoi dati personali di {site_name}"

msgid "Your personal data is ready"
msgstr "I tuoi dati personali sono pronti"

msgid "Download it before {expires_date}."
msgstr "Scaricali entro il {expires_date}."

msgid "The export of your personal data you asked for is ready."
msgstr "L'esportazione dei tuoi dati personali che hai richiesto è pronta."

msgid "Download your data"
msgstr "Scarica i tuoi dati"

msgid "For your privacy, the link works until {expires_date}."
msgstr "Per la tua privacy, il link è valido fino al {expires_date}."

msgid "Your personal data at {site_name} has been erased"
msgstr "I tuoi dati personali su {site_name} sono stati cancellati"

msgid "Your request is complete"
msgstr "La tua richiesta è stata completata"

msgid "We have erased your personal data."
msgstr "Abbiamo cancellato i tuoi dati personali."

msgid "Your request to erase your personal data at {site_name} has been carried out."
msgstr "La tua richiesta di cancellazione dei dati personali su {site_name} è stata eseguita."

msgid "You can read more about how we handle personal data in our <a href=\"{privacy_policy_url}\">privacy policy</a>."
msgstr "Puoi saperne di più su come trattiamo i dati personali nella nostra <a href=\"{privacy_policy_url}\">informativa sulla privacy</a>."

msgid "[{site_name}] New order #{order_number}"
msgstr "[{site_name}] Nuovo ordine #{order_number}"

msgid "New order #{order_number}"
msgstr "Nuovo ordine #{order_number}"

msgid "{customer_name} · {order_total}"
msgstr "{customer_name} · {order_total}"

msgid "You have received a new order from <strong>{customer_name}</strong>."
msgstr "Hai ricevuto un nuovo ordine da <strong>{customer_name}</strong>."

msgid "[{site_name}] Order #{order_number} has been cancelled"
msgstr "[{site_name}] L'ordine #{order_number} è stato annullato"

msgid "Order cancelled: #{order_number}"
msgstr "Ordine annullato: #{order_number}"

msgid "Order <strong>#{order_number}</strong> from {customer_name} has been cancelled."
msgstr "L'ordine <strong>#{order_number}</strong> di {customer_name} è stato annullato."

msgid "[{site_name}] Payment failed for order #{order_number}"
msgstr "[{site_name}] Pagamento non riuscito per l'ordine #{order_number}"

msgid "Payment failed: #{order_number}"
msgstr "Pagamento non riuscito: #{order_number}"

msgid "The payment for order <strong>#{order_number}</strong> from {customer_name} failed. The order was:"
msgstr "Il pagamento dell'ordine <strong>#{order_number}</strong> di {customer_name} non è riuscito. L'ordine era:"
