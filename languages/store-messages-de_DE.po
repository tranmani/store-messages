# Store Messages de_DE translation (customer-facing email texts).
msgid ""
msgstr ""
"Project-Id-Version: Store Messages 1.2.2\n"
"Language: de_DE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: store-messages\n"

msgid "Hi {first_name},"
msgstr "Hallo {first_name},"

msgid "Thank you for shopping with us,"
msgstr "Danke für deinen Einkauf bei uns,"

msgid "Tracking"
msgstr "Sendungsverfolgung"

msgid "Track your package"
msgstr "Paket verfolgen"

msgid "Your order"
msgstr "Deine Bestellung"

msgid "Your order #{order_number} is on its way"
msgstr "Deine Bestellung #{order_number} ist unterwegs"

msgid "Your order is on its way"
msgstr "Deine Bestellung ist unterwegs"

msgid "Track your package: {carrier} {tracking_number}"
msgstr "Verfolge dein Paket: {carrier} {tracking_number}"

msgid "Good news: your order <strong>#{order_number}</strong> has been shipped and is on its way to you."
msgstr "Gute Nachrichten: Deine Bestellung <strong>#{order_number}</strong> wurde versandt und ist auf dem Weg zu dir."

msgid "Tracking can take up to 24 hours to show the first update."
msgstr "Bis die Sendungsverfolgung den ersten Status anzeigt, kann es bis zu 24 Stunden dauern."

msgid "In this parcel"
msgstr "In diesem Paket"

msgid "Shipping to"
msgstr "Lieferung an"

msgid "Your order #{order_number} is ready for pickup"
msgstr "Deine Bestellung #{order_number} ist abholbereit"

msgid "Ready for pickup"
msgstr "Abholbereit"

msgid "Your order is waiting for you at {site_name}."
msgstr "Deine Bestellung wartet bei {site_name} auf dich."

msgid "Your order <strong>#{order_number}</strong> is packed and ready for you to collect."
msgstr "Deine Bestellung <strong>#{order_number}</strong> ist verpackt und liegt zur Abholung für dich bereit."

msgid "Pickup address"
msgstr "Abholadresse"

msgid "Please bring your order number with you."
msgstr "Bitte bring deine Bestellnummer mit."

msgid "An update about your order #{order_number}"
msgstr "Neuigkeiten zu deiner Bestellung #{order_number}"

msgid "An update about your order"
msgstr "Neuigkeiten zu deiner Bestellung"

msgid "One item in your order is unavailable."
msgstr "Ein Artikel deiner Bestellung ist nicht verfügbar."

msgid "Thank you for your order <strong>#{order_number}</strong>. Unfortunately, one of the items you ordered is currently out of stock and we are unable to send it."
msgstr "Vielen Dank für deine Bestellung <strong>#{order_number}</strong>. Leider ist einer der bestellten Artikel derzeit nicht vorrätig, und wir können ihn nicht versenden."

msgid "We have refunded that item to your original payment method. The rest of your order is being prepared as usual."
msgstr "Wir haben dir diesen Artikel über deine ursprüngliche Zahlungsart erstattet. Der Rest deiner Bestellung wird wie gewohnt vorbereitet."

msgid "Refunded: <strong>{refund_amount}</strong>. It can take a few business days to appear on your statement."
msgstr "Erstattet: <strong>{refund_amount}</strong>. Es kann einige Werktage dauern, bis der Betrag auf deinem Kontoauszug erscheint."

msgid "We are very sorry for the inconvenience. Simply reply to this email if you have any questions."
msgstr "Wir entschuldigen uns sehr für die Unannehmlichkeiten. Bei Fragen antworte einfach auf diese E-Mail."

msgid "Your refund for order #{order_number}"
msgstr "Deine Rückerstattung für Bestellung #{order_number}"

msgid "Your refund is on its way"
msgstr "Deine Rückerstattung ist unterwegs"

msgid "Refund of {refund_amount} for order #{order_number}."
msgstr "Rückerstattung von {refund_amount} für Bestellung #{order_number}."

msgid "We have processed a refund of <strong>{refund_amount}</strong> for your order <strong>#{order_number}</strong>."
msgstr "Wir haben eine Rückerstattung von <strong>{refund_amount}</strong> für deine Bestellung <strong>#{order_number}</strong> veranlasst."

msgid "Reason: {refund_reason}"
msgstr "Grund: {refund_reason}"

msgid "Depending on your bank, it can take a few business days for the money to reach your account."
msgstr "Je nach Bank kann es einige Werktage dauern, bis das Geld auf deinem Konto ist."

msgid "Your order #{order_number} needs a little more time"
msgstr "Deine Bestellung #{order_number} braucht etwas mehr Zeit"

msgid "A short delay"
msgstr "Eine kleine Verzögerung"

msgid "An update on when your order will ship."
msgstr "Neuigkeiten zum Versand deiner Bestellung."

msgid "We wanted to let you know that your order <strong>#{order_number}</strong> is taking a little longer than usual to prepare."
msgstr "Wir möchten dich kurz informieren, dass die Vorbereitung deiner Bestellung <strong>#{order_number}</strong> etwas länger dauert als üblich."

msgid "We will send you the tracking link as soon as it ships. Thank you for your patience!"
msgstr "Sobald sie versandt ist, schicken wir dir den Link zur Sendungsverfolgung. Danke für deine Geduld!"

msgid "Complete your order #{order_number}"
msgstr "Schließe deine Bestellung #{order_number} ab"

msgid "Your order is waiting"
msgstr "Deine Bestellung wartet"

msgid "Finish your payment to confirm order #{order_number}."
msgstr "Schließe deine Zahlung ab, um die Bestellung #{order_number} zu bestätigen."

msgid "Your order <strong>#{order_number}</strong> ({order_total}) is not paid yet. You can complete the payment securely with the button below."
msgstr "Deine Bestellung <strong>#{order_number}</strong> ({order_total}) ist noch nicht bezahlt. Über den Button unten kannst du die Zahlung sicher abschließen."

msgid "Complete payment"
msgstr "Zahlung abschließen"

msgid "How are you enjoying your order, {first_name}?"
msgstr "Wie gefällt dir deine Bestellung, {first_name}?"

msgid "How did we do?"
msgstr "Wie zufrieden bist du?"

msgid "Your feedback helps other customers."
msgstr "Deine Meinung hilft anderen Kundinnen und Kunden."

msgid "We hope you are enjoying your order. Would you take a minute to tell other customers what you think? It means a lot to a small business like ours."
msgstr "Wir hoffen, deine Bestellung gefällt dir. Nimmst du dir kurz eine Minute, um anderen Kunden deine Meinung mitzuteilen? Für ein kleines Unternehmen wie unseres bedeutet das sehr viel."

msgid "Leave a review"
msgstr "Bewertung abgeben"

msgid "A message about your order #{order_number}"
msgstr "Eine Nachricht zu deiner Bestellung #{order_number}"

msgid "A message from {site_name}"
msgstr "Eine Nachricht von {site_name}"

msgid "A note about your order #{order_number}"
msgstr "Ein Hinweis zu deiner Bestellung #{order_number}"

msgid "A note about your order"
msgstr "Ein Hinweis zu deiner Bestellung"

msgid "Order #{order_number} · placed {order_date}"
msgstr "Bestellung #{order_number} · aufgegeben am {order_date}"

msgid "Welcome to {site_name}{if coupon_code}: your {coupon_amount} code{/if}"
msgstr "Willkommen bei {site_name}{if coupon_code}: dein Gutscheincode über {coupon_amount}{/if}"

msgid "Thanks for signing up!"
msgstr "Danke für deine Anmeldung!"

msgid "Your personal code for {coupon_amount} off your first order is inside."
msgstr "Hier ist dein persönlicher Code für {coupon_amount} Rabatt auf deine erste Bestellung."

msgid "Good to have you with us."
msgstr "Schön, dass du dabei bist."

msgid "Hello,"
msgstr "Hallo,"

msgid "Welcome to {site_name}! From now on you are the first to hear about new products and offers."
msgstr "Willkommen bei {site_name}! Ab sofort erfährst du als Erstes von neuen Produkten und Angeboten."

msgid "Your personal code"
msgstr "Dein persönlicher Code"

msgid "{coupon_amount} off your first order{if coupon_expires}, valid until {coupon_expires}{/if}. Enter it at checkout."
msgstr "{coupon_amount} Rabatt auf deine erste Bestellung{if coupon_expires}, gültig bis {coupon_expires}{/if}. Gib ihn einfach an der Kasse ein."

msgid "Start shopping"
msgstr "Jetzt einkaufen"

msgid "Our bestsellers"
msgstr "Unsere Bestseller"

msgid "Please confirm your subscription to {site_name}"
msgstr "Bitte bestätige deine Anmeldung bei {site_name}"

msgid "One more step"
msgstr "Nur noch ein Schritt"

msgid "Confirm your email address to start receiving our news."
msgstr "Bestätige deine E-Mail-Adresse, um unsere Neuigkeiten zu erhalten."

msgid "Please confirm that you want to receive emails from {site_name}."
msgstr "Bitte bestätige, dass du E-Mails von {site_name} erhalten möchtest."

msgid "Yes, subscribe me"
msgstr "Ja, ich möchte mich anmelden"

msgid "If you did not sign up, simply ignore this email: you will not hear from us."
msgstr "Falls du dich nicht angemeldet hast, ignoriere diese E-Mail einfach: Du hörst dann nichts mehr von uns."

msgid "Questions? Just reply to this email."
msgstr "Fragen? Antworte einfach auf diese E-Mail."

msgid "Unsubscribe"
msgstr "Abmelden"

msgid "Your {site_name} order #{order_number} has been received"
msgstr "Deine Bestellung #{order_number} bei {site_name} ist eingegangen"

msgid "Thank you for your order"
msgstr "Danke für deine Bestellung"

msgid "We have received your order and are getting it ready."
msgstr "Wir haben deine Bestellung erhalten und bereiten sie vor."

msgid "We have received your order <strong>#{order_number}</strong> and are now getting it ready. We will let you know as soon as it is on its way."
msgstr "Wir haben deine Bestellung <strong>#{order_number}</strong> erhalten und bereiten sie jetzt vor. Wir melden uns, sobald sie unterwegs ist."

msgid "Your order is on hold until we receive your payment."
msgstr "Deine Bestellung wartet auf deine Zahlung."

msgid "Thank you for your order <strong>#{order_number}</strong>. It is on hold until we confirm that your payment has been received."
msgstr "Danke für deine Bestellung <strong>#{order_number}</strong>. Sie ist in Wartestellung, bis wir bestätigen können, dass deine Zahlung eingegangen ist."

msgid "Your {site_name} order #{order_number} is complete"
msgstr "Deine Bestellung #{order_number} bei {site_name} ist abgeschlossen"

msgid "Your order is complete"
msgstr "Deine Bestellung ist abgeschlossen"

msgid "We have finished processing your order."
msgstr "Wir haben die Bearbeitung deiner Bestellung abgeschlossen."

msgid "We have finished processing your order <strong>#{order_number}</strong>."
msgstr "Wir haben die Bearbeitung deiner Bestellung <strong>#{order_number}</strong> abgeschlossen."

msgid "Your {site_name} order #{order_number} has been partially refunded"
msgstr "Deine Bestellung #{order_number} bei {site_name} wurde teilweise erstattet"

msgid "Your {site_name} order #{order_number} has been refunded"
msgstr "Deine Bestellung #{order_number} bei {site_name} wurde erstattet"

msgid "Partial refund issued"
msgstr "Teilrückerstattung veranlasst"

msgid "Your order has been refunded"
msgstr "Deine Bestellung wurde erstattet"

msgid "We have refunded <strong>{refund_amount}</strong> of your order <strong>#{order_number}</strong>."
msgstr "Wir haben dir <strong>{refund_amount}</strong> deiner Bestellung <strong>#{order_number}</strong> erstattet."

msgid "Your order <strong>#{order_number}</strong> has been refunded in full: <strong>{refund_amount}</strong>."
msgstr "Deine Bestellung <strong>#{order_number}</strong> wurde vollständig erstattet: <strong>{refund_amount}</strong>."

msgid "The money goes back to your original payment method. It can take a few business days to appear on your statement."
msgstr "Das Geld geht zurück auf deine ursprüngliche Zahlungsart. Es kann einige Werktage dauern, bis der Betrag auf deinem Kontoauszug erscheint."

msgid "Your {site_name} order #{order_number} was unsuccessful"
msgstr "Deine Bestellung #{order_number} bei {site_name} war nicht erfolgreich"

msgid "Your payment did not go through"
msgstr "Deine Zahlung ist nicht durchgegangen"

msgid "You can try again with another payment method."
msgstr "Du kannst es mit einer anderen Zahlungsart erneut versuchen."

msgid "Unfortunately, we could not complete your order <strong>#{order_number}</strong> because of a problem with the payment."
msgstr "Leider konnten wir deine Bestellung <strong>#{order_number}</strong> wegen eines Problems mit der Zahlung nicht abschliessen."

msgid "If you would still like to place it, you can pay again, with another payment method if you like."
msgstr "Wenn du sie trotzdem aufgeben möchtest, kannst du erneut bezahlen, gerne auch mit einer anderen Zahlungsart."

msgid "Pay for this order"
msgstr "Diese Bestellung bezahlen"

msgid "Your {site_name} order #{order_number} has been cancelled"
msgstr "Deine Bestellung #{order_number} bei {site_name} wurde storniert"

msgid "Your order has been cancelled"
msgstr "Deine Bestellung wurde storniert"

msgid "Order #{order_number} has been cancelled."
msgstr "Bestellung #{order_number} wurde storniert."

msgid "We are writing to let you know that your order <strong>#{order_number}</strong> has been cancelled."
msgstr "Wir möchten dir mitteilen, dass deine Bestellung <strong>#{order_number}</strong> storniert wurde."

msgid "Invoice for order #{order_number} at {site_name}"
msgstr "Rechnung zu Bestellung #{order_number} bei {site_name}"

msgid "Details of your order #{order_number}"
msgstr "Details zu deiner Bestellung #{order_number}"

msgid "Your invoice"
msgstr "Deine Rechnung"

msgid "Your order details"
msgstr "Deine Bestelldetails"

msgid "Order #{order_number} · {order_total}"
msgstr "Bestellung #{order_number} · {order_total}"

msgid "An order has been created for you at {site_name}. You can pay for it with the button below."
msgstr "Für dich wurde bei {site_name} eine Bestellung erstellt. Du kannst sie mit dem Button unten bezahlen."

msgid "Here are the details of your order <strong>#{order_number}</strong>, placed on {order_date}."
msgstr "Hier sind die Details deiner Bestellung <strong>#{order_number}</strong> vom {order_date}."

msgid "Reset your {site_name} password"
msgstr "Setze dein Passwort für {site_name} zurück"

msgid "Reset your password"
msgstr "Setze dein Passwort zurück"

msgid "Someone asked for a new password for your account."
msgstr "Jemand hat ein neues Passwort für dein Konto angefordert."

msgid "Someone asked for a new password for the account <strong>{user_login}</strong> at {site_name}."
msgstr "Jemand hat ein neues Passwort für das Konto <strong>{user_login}</strong> bei {site_name} angefordert."

msgid "Choose a new password"
msgstr "Neues Passwort wählen"

msgid "If you did not ask for this, simply ignore this email: your password stays the same."
msgstr "Falls du das nicht warst, ignoriere diese E-Mail einfach: Dein Passwort bleibt unverändert."

msgid "Your account at {site_name} has been created"
msgstr "Dein Konto bei {site_name} wurde erstellt"

msgid "Welcome to {site_name}"
msgstr "Willkommen bei {site_name}"

msgid "Your account is ready."
msgstr "Dein Konto ist bereit."

msgid "Thank you for creating an account at {site_name}. Your username is <strong>{user_login}</strong>."
msgstr "Danke, dass du bei {site_name} ein Konto erstellt hast. Dein Benutzername ist <strong>{user_login}</strong>."

msgid "Choose your password with the button below to start using your account."
msgstr "Wähle mit dem Button unten dein Passwort, um dein Konto zu nutzen."

msgid "Choose your password"
msgstr "Passwort wählen"

msgid "In your account you can see your orders, change your addresses and your password."
msgstr "In deinem Konto siehst du deine Bestellungen und kannst deine Adressen und dein Passwort ändern."

msgid "Go to my account"
msgstr "Zu meinem Konto"

msgid "Confirm your email address for {site_name}"
msgstr "Bestätige deine E-Mail-Adresse für {site_name}"

msgid "Confirm your email address"
msgstr "Bestätige deine E-Mail-Adresse"

msgid "One click to link your past orders to your account."
msgstr "Ein Klick, um deine früheren Bestellungen mit deinem Konto zu verknüpfen."

msgid "Please confirm that <strong>{customer_email}</strong> is your email address. Orders you placed with it as a guest will then appear in your account."
msgstr "Bitte bestätige, dass <strong>{customer_email}</strong> deine E-Mail-Adresse ist. Bestellungen, die du damit als Gast aufgegeben hast, erscheinen dann in deinem Konto."

msgid "Confirm email address"
msgstr "E-Mail-Adresse bestätigen"

msgid "If you did not ask for this, simply ignore this email."
msgstr "Falls du das nicht warst, ignoriere diese E-Mail einfach."

msgid "Your {site_name} password was changed"
msgstr "Dein Passwort für {site_name} wurde geändert"

msgid "Your password was changed"
msgstr "Dein Passwort wurde geändert"

msgid "A confirmation for your security."
msgstr "Eine Bestätigung zu deiner Sicherheit."

msgid "This is a confirmation that the password of your account <strong>{user_login}</strong> at {site_name} was just changed."
msgstr "Hiermit bestätigen wir, dass das Passwort deines Kontos <strong>{user_login}</strong> bei {site_name} soeben geändert wurde."

msgid "If you did not change it, please contact us right away at {store_email}."
msgstr "Falls du es nicht geändert hast, melde dich bitte sofort bei uns unter {store_email}."

msgid "Your {site_name} email address was changed"
msgstr "Deine E-Mail-Adresse bei {site_name} wurde geändert"

msgid "Your email address was changed"
msgstr "Deine E-Mail-Adresse wurde geändert"

msgid "This is a confirmation that the email address of your account at {site_name} was changed to <strong>{new_email}</strong>."
msgstr "Hiermit bestätigen wir, dass die E-Mail-Adresse deines Kontos bei {site_name} auf <strong>{new_email}</strong> geändert wurde."

msgid "Confirm your new email address for {site_name}"
msgstr "Bestätige deine neue E-Mail-Adresse für {site_name}"

msgid "Confirm your new email address"
msgstr "Bestätige deine neue E-Mail-Adresse"

msgid "One click to confirm your new address."
msgstr "Ein Klick, um deine neue Adresse zu bestätigen."

msgid "You asked to change the email address of your account at {site_name} to <strong>{new_email}</strong>. Please confirm it with the button below."
msgstr "Du hast darum gebeten, die E-Mail-Adresse deines Kontos bei {site_name} auf <strong>{new_email}</strong> zu ändern. Bitte bestätige sie mit dem Button unten."

msgid "Confirm new email address"
msgstr "Neue E-Mail-Adresse bestätigen"

msgid "Please confirm your request: {request_type}"
msgstr "Bitte bestätige deine Anfrage: {request_type}"

msgid "Please confirm your request"
msgstr "Bitte bestätige deine Anfrage"

msgid "We received a request to do the following with your personal data at {site_name}: <strong>{request_type}</strong>."
msgstr "Wir haben eine Anfrage zu deinen persönlichen Daten bei {site_name} erhalten: <strong>{request_type}</strong>."

msgid "Confirm request"
msgstr "Anfrage bestätigen"

msgid "Your personal data from {site_name}"
msgstr "Deine persönlichen Daten von {site_name}"

msgid "Your personal data is ready"
msgstr "Deine persönlichen Daten sind bereit"

msgid "Download it before {expires_date}."
msgstr "Lade sie vor dem {expires_date} herunter."

msgid "The export of your personal data you asked for is ready."
msgstr "Der von dir angeforderte Export deiner persönlichen Daten ist bereit."

msgid "Download your data"
msgstr "Daten herunterladen"

msgid "For your privacy, the link works until {expires_date}."
msgstr "Zum Schutz deiner Privatsphäre ist der Link bis zum {expires_date} gültig."

msgid "Your personal data at {site_name} has been erased"
msgstr "Deine persönlichen Daten bei {site_name} wurden gelöscht"

msgid "Your request is complete"
msgstr "Deine Anfrage ist erledigt"

msgid "We have erased your personal data."
msgstr "Wir haben deine persönlichen Daten gelöscht."

msgid "Your request to erase your personal data at {site_name} has been carried out."
msgstr "Deine Anfrage zur Löschung deiner persönlichen Daten bei {site_name} wurde ausgeführt."

msgid "You can read more about how we handle personal data in our <a href=\"{privacy_policy_url}\">privacy policy</a>."
msgstr "Mehr dazu, wie wir mit persönlichen Daten umgehen, findest du in unserer <a href=\"{privacy_policy_url}\">Datenschutzerklärung</a>."

msgid "[{site_name}] New order #{order_number}"
msgstr "[{site_name}] Neue Bestellung #{order_number}"

msgid "New order #{order_number}"
msgstr "Neue Bestellung #{order_number}"

msgid "{customer_name} · {order_total}"
msgstr "{customer_name} · {order_total}"

msgid "You have received a new order from <strong>{customer_name}</strong>."
msgstr "Du hast eine neue Bestellung von <strong>{customer_name}</strong> erhalten."

msgid "[{site_name}] Order #{order_number} has been cancelled"
msgstr "[{site_name}] Bestellung #{order_number} wurde storniert"

msgid "Order cancelled: #{order_number}"
msgstr "Bestellung storniert: #{order_number}"

msgid "Order <strong>#{order_number}</strong> from {customer_name} has been cancelled."
msgstr "Die Bestellung <strong>#{order_number}</strong> von {customer_name} wurde storniert."

msgid "[{site_name}] Payment failed for order #{order_number}"
msgstr "[{site_name}] Zahlung für Bestellung #{order_number} fehlgeschlagen"

msgid "Payment failed: #{order_number}"
msgstr "Zahlung fehlgeschlagen: #{order_number}"

msgid "The payment for order <strong>#{order_number}</strong> from {customer_name} failed. The order was:"
msgstr "Die Zahlung für die Bestellung <strong>#{order_number}</strong> von {customer_name} ist fehlgeschlagen. Die Bestellung lautete:"
